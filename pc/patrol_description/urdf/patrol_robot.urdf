<?xml version="1.0"?>
<robot name="patrol_robot">
  <material name="blue"><color rgba="0.1 0.3 0.8 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
  <material name="gray"><color rgba="0.4 0.4 0.4 1.0"/></material>

  <link name="base_footprint"/>
  
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.095" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.35 0.28 0.15"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="0.35 0.28 0.15"/></geometry></collision>
    <inertial>
      <mass value="2.0"/>
      <!-- 质心稍微下移，增加底盘平稳性 -->
      <origin xyz="0 0 -0.02"/>
      <inertia ixx="0.0150" ixy="0.0" ixz="0.0" iyy="0.0242" iyz="0.0" izz="0.0317"/>
    </inertial>
  </link>

  <!-- ============ 左轮（放大惯性，防止起飞） ============ -->
  <link name="left_wheel_link">
    <visual><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
    <inertial>
      <mass value="0.2"/>
      <!-- 【核心修正】惯性值放大 10 倍，防止 ODE 引擎数值爆炸 -->
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0015" iyz="0.0" izz="0.0025"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel_link"/>
    <origin xyz="0 0.15 -0.045" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.0"/>
    <limit effort="50" velocity="10"/>
  </joint>

  <!-- ============ 右轮 ============ -->
  <link name="right_wheel_link">
    <visual><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0015" iyz="0.0" izz="0.0025"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel_link"/>
    <origin xyz="0 -0.15 -0.045" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.0"/>
    <limit effort="50" velocity="10"/>
  </joint>

  <!-- ============ 后万向球 ============ -->
  <link name="caster_link">
    <visual><geometry><sphere radius="0.03"/></geometry><material name="gray"/></visual>
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster_link"/>
    <origin xyz="-0.14 0 -0.065" rpy="0 0 0"/>
  </joint>

  <!-- ============ 前万向球 ============ -->
  <link name="front_caster_link">
    <visual><geometry><sphere radius="0.03"/></geometry><material name="gray"/></visual>
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/></inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/><child link="front_caster_link"/>
    <origin xyz="0.14 0 -0.065" rpy="0 0 0"/>
  </joint>

  <!-- ============ 激光雷达 ============ -->
  <link name="laser_link">
    <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry><material name="red"/></visual>
    <collision><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_link"/>
    <origin xyz="0.05 0 0.095" rpy="0 0 0"/>
  </joint>

  <!-- ================== Gazebo 物理属性 ================== -->
  <!-- 【核心修正】加入 kp/kd，防止轮子砸穿地面导致飞天 -->
  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  
  <!-- 前后万向球：极低摩擦，但要有接触刚度 -->
  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  
  <gazebo reference="front_caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <!-- 【核心修复】用 remapping 强制 Gazebo 监听 cmd_vel_sim -->
      <ros>
        <remapping>cmd_vel:=cmd_vel_sim</remapping>
      </ros>
      
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.30</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>
      <max_wheel_torque>50</max_wheel_torque>
      <max_wheel_acceleration>100.0</max_wheel_acceleration>
      
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <publishWheelJointState>true</publishWheelJointState>
      <update_rate>100</update_rate>
    </plugin>
  </gazebo>

  <gazebo reference="laser_link">
    <sensor type="ray" name="laser_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.10</min><max>10.0</max><resolution>0.01</resolution></range>
      </ray>
      <plugin name="laser_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
